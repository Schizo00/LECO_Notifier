SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-account@gmail.com

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this as secret as SMTP_PASS — it's the only thing that can decrypt
# data/subscribers.json.enc and data/state.json.enc. Losing it makes those
# files unrecoverable (subscribers would need to re-subscribe); leaking it
# is equivalent to leaking their plaintext contents.
LECO_ENCRYPTION_KEY=your-generated-fernet-key
